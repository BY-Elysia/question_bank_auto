{
  "name": "@question-bank/backend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Single-workspace textbook PDF extraction, review, repair and JSON export backend",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "build": "node scripts/clean-app.mjs && tsc -p tsconfig.build.json && node scripts/build-contracts.mjs",
    "contracts:build": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "redocly lint dist/contracts/openapi.json",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "start:api": "node dist/app/apps/control-api/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"test/*.mjs\""
  },
  "devDependencies": {
    "@redocly/cli": "2.67.1",
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "archiver": "8.0.0",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}

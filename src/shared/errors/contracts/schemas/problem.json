{
  "name": "Problem",
  "typeFile": "src/shared/errors/problem.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "type": {
        "type": "string",
        "format": "uri"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "code": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VERSION_CONFLICT",
          "PRECONDITION_REQUIRED",
          "IDEMPOTENCY_CONFLICT",
          "QUOTA_EXCEEDED",
          "RATE_LIMITED",
          "WORKSPACE_NOT_READY",
          "ASSET_IN_USE",
          "LEASE_EXPIRED",
          "EVENT_CURSOR_EXPIRED",
          "PROVIDER_UNAVAILABLE",
          "INTERNAL_ERROR",
          "NOT_IMPLEMENTED"
        ]
      },
      "detail": {
        "type": "string",
        "maxLength": 200000
      },
      "requestId": {
        "type": "string",
        "format": "uuid"
      },
      "retryable": {
        "type": "boolean"
      },
      "errors": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ErrorDetail"
        }
      }
    },
    "required": [
      "type",
      "title",
      "status",
      "code",
      "detail",
      "requestId",
      "retryable"
    ]
  }
}

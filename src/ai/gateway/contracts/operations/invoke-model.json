{
  "path": "/internal/v1/jobs/{jobId}/model-invocations",
  "method": "post",
  "operation": {
    "operationId": "invokeModel",
    "tags": [
      "Gateway"
    ],
    "summary": "通过冻结配置调用外部模型",
    "description": "短期令牌和活跃租约双重校验；网关解析凭证并限制当前 Skill 的模型能力、调用数与预算。供应商超时无法确认结果时记录 unknown，不保证供应商端 exactly-once。结构或语义无效的响应登记为模型错误，由工作流决定修复。 内部端点不得暴露到公网入口；工作区令牌还需具备该操作 scope。",
    "x-audience": "workspace",
    "security": [
      {
        "WorkspaceBearer": []
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "jobId",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },

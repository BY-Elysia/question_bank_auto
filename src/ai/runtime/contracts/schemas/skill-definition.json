{
  "name": "SkillDefinition",
  "typeFile": "src/ai/runtime/contracts/skill-definition.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "$ref": "#/components/schemas/SkillId"
      },
      "version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 200000
      },
      "mode": {
        "type": "string",
        "enum": [
          "single-call",
          "tool-loop"
        ]
      },
      "modelRole": {
        "$ref": "#/components/schemas/ModelRole"
      },
      "inputSchemaRef": {
        "type": "string"
      },
      "outputSchemaRef": {
        "type": "string"
      },
      "allowedTools": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ToolId"
        },
        "uniqueItems": true
      },
      "maxModelCalls": {
        "type": "integer",
        "minimum": 1
      },
      "maxToolCalls": {
        "type": "integer",
        "minimum": 0
      },
      "status": {
        "type": "string",
        "enum": [
          "planned",
          "active",
          "deprecated"
        ]
      },
      "requiredCapabilities": {
        "$ref": "#/components/schemas/ModelCapabilities"
      }
    },
    "required": [
      "id",
      "version",
      "description",
      "mode",
      "modelRole",
      "inputSchemaRef",
      "outputSchemaRef",
      "allowedTools",
      "maxModelCalls",
      "maxToolCalls",
      "status",
      "requiredCapabilities"
    ]
  }
}

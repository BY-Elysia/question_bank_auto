      },
      "version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": {
        "type": "string",
        "maxLength": 200000
      },
      "skills": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SkillId"
        }
      },
      "inputSchemaRef": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "planned",
          "active",
          "deprecated"
        ]
      }
    },
    "required": [
      "id",
      "version",
      "description",
      "skills",
      "inputSchemaRef",
      "status"
    ]
  }
}

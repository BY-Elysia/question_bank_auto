{
  "name": "ExamExtractionRequest",
  "typeFile": "src/ai/workflows/exam-extraction/contracts/exam-extraction-request.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "exam-extraction"
        ]
      },
      "documentId": {
        "type": "string",
        "format": "uuid"
      },
      "baseRevision": {
        "type": "integer",
        "minimum": 1
      },
      "pageAssetIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "minItems": 1
      },
      "initialNodeId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "strategy": {
        "type": "string",
        "enum": [
          "standard",
          "prefix-cache"
        ]
      },
      "verification": {
        "type": "string",
        "enum": [
          "flagged",
          "all"
        ]
      },
      "maxPendingPages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "required": [
      "kind",
      "documentId",
      "baseRevision",
      "pageAssetIds",
      "initialNodeId",
      "strategy",
      "verification",
      "maxPendingPages"
    ]
  }
}

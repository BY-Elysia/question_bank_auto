{
  "name": "ExamSectionSelection",
  "typeFile": "src/ai/workflows/exam-compose/contracts/exam-section-selection.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "questionVersionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "scorePerQuestion": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "title",
      "questionVersionIds",
      "scorePerQuestion"
    ]
  }
}

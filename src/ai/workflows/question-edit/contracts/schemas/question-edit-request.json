{
  "name": "QuestionEditRequest",
  "typeFile": "src/ai/workflows/question-edit/contracts/question-edit-request.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "question-edit"
        ]
      },
      "documentId": {
        "type": "string",
        "format": "uuid"
      },
      "baseRevision": {
        "type": "integer",
        "minimum": 1
      },
      "questionId": {
        "type": "string",
        "format": "uuid"
      },
      "input": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SourceVerifyInput"
          },
          {
            "$ref": "#/components/schemas/QuestionRepairInput"
          },
          {
            "$ref": "#/components/schemas/MathRepairInput"
          },
          {
            "$ref": "#/components/schemas/AnswerGenerateInput"
          },
          {
            "$ref": "#/components/schemas/QuestionTypeInput"
          }
        ]
      },
      "targetPointer": {
        "type": "string",
        "pattern": "^/questions/[0-9]+(/.*)?$"
      }
    },
    "required": [
      "kind",
      "documentId",
      "baseRevision",
      "questionId",
      "input",
      "targetPointer"
    ],
    "description": "input.question 必须与 baseRevision 中 questionId 对应内容一致；targetPointer 必须定位该题或其子题，且符合 Skill 字段权限。"
  }
}

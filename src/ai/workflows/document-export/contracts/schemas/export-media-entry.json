{
  "name": "ExportMediaEntry",
  "typeFile": "src/ai/workflows/document-export/contracts/export-media-entry.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assetId": {
        "$ref": "#/components/schemas/Id"
      },
      "relativePath": {
        "type": "string",
        "pattern": "^media/[A-Za-z0-9_-]+\\.(png|jpg|jpeg|webp)$"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "assetId",
      "relativePath",
      "sha256"
    ]
  }
}

{
  "name": "SourceVerifyOutput",
  "typeFile": "src/ai/skills/question-source-verify/contracts/source-verify-output.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "question-source-verify"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input"
        ]
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ValidationIssue"
        }
      },
      "suggestedQuestion": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Question"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "kind",
      "status",
      "issues",
      "suggestedQuestion"
    ]
  }
}

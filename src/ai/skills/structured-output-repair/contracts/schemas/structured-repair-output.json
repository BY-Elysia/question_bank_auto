{
  "name": "StructuredRepairOutput",
  "typeFile": "src/ai/skills/structured-output-repair/contracts/structured-repair-output.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "structured-output-repair"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input"
        ]
      },
      "repairedJson": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 200000
          },
          {
            "type": "null"
          }
        ]
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SkillIssue"
        }
      }
    },
    "required": [
      "kind",
      "status",
      "repairedJson",
      "issues"
    ],
    "description": "repairedJson 解析后必须再次按 targetSchemaRef 校验；字符串不是可跳过校验的任意写入入口。",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "repairedJson": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      }
    ]
  }
}

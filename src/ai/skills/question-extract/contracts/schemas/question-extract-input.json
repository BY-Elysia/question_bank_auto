{
  "name": "QuestionExtractInput",
  "typeFile": "src/ai/skills/question-extract/contracts/question-extract-input.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "question-extract"
        ]
      },
      "documentKind": {
        "type": "string",
        "enum": [
          "textbook",
          "exam"
        ]
      },
      "nodeId": {
        "type": "string",
        "format": "uuid"
      },
      "ranges": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/QuestionRange"
        },
        "minItems": 1
      },
      "answerMode": {
        "type": "string",
        "enum": [
          "extract_visible",
          "leave_empty"
        ]
      }
    },
    "required": [
      "kind",
      "documentKind",
      "nodeId",
      "ranges",
      "answerMode"
    ]
  }
}

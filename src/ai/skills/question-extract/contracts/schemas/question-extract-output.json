{
  "name": "QuestionExtractOutput",
  "typeFile": "src/ai/skills/question-extract/contracts/question-extract-output.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "question-extract"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input"
        ]
      },
      "result": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ExtractedQuestions"
          },
          {
            "type": "null"
          }
        ]
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SkillIssue"
        }
      }
    },
    "required": [
      "kind",
      "status",
      "result",
      "issues"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "properties": {
            "result": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      }
    ]
  }
}

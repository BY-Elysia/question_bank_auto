{
  "name": "ExtractedQuestions",
  "typeFile": "src/ai/skills/question-extract/contracts/extracted-questions.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "questions": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Question"
        }
      },
      "cropSuggestions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceAssetId": {
              "type": "string",
              "format": "uuid"
            },
            "region": {
              "$ref": "#/components/schemas/CropBox"
            },
            "questionId": {
              "type": "string",
              "format": "uuid"
            },
            "target": {
              "type": "string",
              "enum": [
                "prompt",
                "answer",
                "stem"
              ]
            }
          },
          "required": [
            "sourceAssetId",
            "region",
            "questionId",
            "target"
          ]
        }
      }
    },
    "required": [
      "questions",
      "cropSuggestions"
    ]
  }
}

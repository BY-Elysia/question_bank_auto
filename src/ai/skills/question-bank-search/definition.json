{
  "id": "question-bank-search",
  "version": "1.0.0",
  "description": "通过受限工具检索真实题库记录",
  "mode": "tool-loop",
  "modelRole": "reasoning",
  "inputSchemaRef": "openapi.json#/components/schemas/LibrarySearchInput",
  "outputSchemaRef": "openapi.json#/components/schemas/LibrarySearchOutput",
  "allowedTools": [
    "library.list-sources",
    "library.list-nodes",
    "library.search-questions",
    "documents.read-question"
  ],
  "maxModelCalls": 5,
  "maxToolCalls": 10,
  "status": "planned",
  "requiredCapabilities": {
    "vision": false,
    "tools": true,
    "structuredOutput": true
  }
}

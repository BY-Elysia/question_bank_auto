{
  "name": "LibrarySearchOutput",
  "typeFile": "src/ai/skills/question-bank-search/contracts/library-search-output.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "question-bank-search"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "needs_input"
        ]
      },
      "questionVersionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "explanation": {
        "type": "string",
        "maxLength": 200000
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SkillIssue"
        }
      }
    },
    "required": [
      "kind",
      "status",
      "questionVersionIds",
      "explanation",
      "issues"
    ],
    "description": "只能引用本次工具调用实际返回、当前用户有权访问的题目版本。"
  }
}

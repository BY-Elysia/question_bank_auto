    "additionalProperties": false,
    "properties": {
      "documentId": {
        "type": "string",
        "format": "uuid"
      },
      "baseRevision": {
        "type": "integer",
        "minimum": 1
      },
      "changes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DocumentChange"
        },
        "minItems": 1
      }
    },
    "required": [
      "documentId",
      "baseRevision",
      "changes"
    ]
  }
}

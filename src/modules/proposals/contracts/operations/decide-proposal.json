{
  "path": "/api/v1/proposals/{proposalId}/decision",
  "method": "post",
  "operation": {
    "operationId": "decideProposal",
    "tags": [
      "Proposals"
    ],
    "summary": "应用或拒绝候选修改",
    "description": "If-Match 指向文档当前 revision；apply 还要求 baseRevision 等于当前版本且无 error 级校验问题，全部 changes 原子应用。成功后 appliedRevision 返回新版本；reject 不改变文档。已决定的 proposal 再决策 409，同幂等键重放除外。",
    "x-audience": "public",
    "security": [
      {
        "UserBearer": []
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "proposalId",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "$ref": "#/components/parameters/IdempotencyKey"
      },
      {
        "$ref": "#/components/parameters/IfMatch"
      }
    ],
    "responses": {
      "200": {
        "description": "请求成功",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "请求追踪 ID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Proposal"
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/E400"
      },
      "401": {
        "$ref": "#/components/responses/E401"
      },
      "403": {
        "$ref": "#/components/responses/E403"
      },
      "404": {
        "$ref": "#/components/responses/E404"
      },
      "409": {
        "$ref": "#/components/responses/E409"
      },
      "412": {
        "$ref": "#/components/responses/E412"
      },
      "422": {
        "$ref": "#/components/responses/E422"
      },
      "428": {
        "$ref": "#/components/responses/E428"
      },
      "429": {
        "$ref": "#/components/responses/E429"
      },
      "501": {
        "$ref": "#/components/responses/NotImplemented"
      },
      "503": {
        "$ref": "#/components/responses/E503"
      },
      "default": {
        "$ref": "#/components/responses/Unexpected"
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/ProposalDecision"
          },
          "examples": {
            "example1": {
              "summary": "应用提取候选修改",
              "value": {
                "decision": "apply"
              }
            }
          }
        }
      }
    }
  }
}

{
  "name": "ValidationIssue",
  "typeFile": "src/modules/documents/domain/validation-issue.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "severity": {
        "type": "string",
        "enum": [
          "error",
          "warning"
        ]
      },
      "code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "pointer": {
        "type": "string"
      },
      "message": {
        "type": "string",
        "maxLength": 200000
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SourceEvidence"
        }
      }
    },
    "required": [
      "severity",
      "code",
      "pointer",
      "message",
      "evidence"
    ]
  }
}

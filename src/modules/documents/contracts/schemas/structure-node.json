{
  "name": "StructureNode",
  "typeFile": "src/modules/documents/domain/structure-node.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "parentId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "chapter",
          "section",
          "exam_section",
          "subsection"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SourceEvidence"
        }
      }
    },
    "required": [
      "id",
      "parentId",
      "kind",
      "title",
      "order",
      "evidence"
    ]
  }
}

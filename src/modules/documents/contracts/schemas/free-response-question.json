{
  "name": "FreeResponseQuestion",
  "typeFile": "src/modules/documents/domain/free-response-question.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "nodeId": {
        "type": "string",
        "format": "uuid"
      },
      "title": {
        "type": "string",
        "maxLength": 500
      },
      "prompt": {
        "$ref": "#/components/schemas/TextBlock"
      },
      "answer": {
        "$ref": "#/components/schemas/Answer"
      },
      "score": {
        "type": "number",
        "minimum": 0
      },
      "rubric": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RubricItem"
        }
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SourceEvidence"
        }
      },
      "kind": {
        "type": "string",
        "enum": [
          "free_response"
        ]
      },
      "responseType": {
        "type": "string",
        "enum": [
          "fill_blank",
          "short_answer",
          "proof",
          "calculation",
          "code",
          "other"
        ]
      }
    },
    "required": [
      "id",
      "nodeId",
      "title",
      "prompt",
      "answer",
      "score",
      "rubric",
      "evidence",
      "kind",
      "responseType"
    ]
  }
}

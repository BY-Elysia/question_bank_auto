{
  "name": "DocumentRevision",
  "typeFile": "src/modules/documents/domain/document-revision.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "documentId": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "content": {
        "$ref": "#/components/schemas/DocumentContent"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "origin": {
        "type": "string",
        "enum": [
          "create",
          "manual",
          "proposal",
          "import",
          "restore"
        ]
      },
      "sourceJobId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "documentId",
      "revision",
      "content",
      "createdAt",
      "origin",
      "sourceJobId"
    ]
  }
}

{
  "name": "TextbookContent",
  "typeFile": "src/modules/documents/domain/textbook-content.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {
        "type": "string",
        "enum": [
          "1.0"
        ]
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "courseId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "answerMode": {
        "type": "string",
        "enum": [
          "extract_visible",
          "leave_empty",
          "generate"
        ]
      },
      "nodes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/StructureNode"
        }
      },
      "questions": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Question"
        }
      },
      "kind": {
        "type": "string",
        "enum": [
          "textbook"
        ]
      },
      "publisher": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required": [
      "schemaVersion",
      "title",
      "subject",
      "courseId",
      "answerMode",
      "nodes",
      "questions",
      "kind",
      "publisher"
    ]
  }
}

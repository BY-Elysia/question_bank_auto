{
  "name": "GroupQuestion",
  "typeFile": "src/modules/documents/domain/group-question.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "nodeId": {
        "type": "string",
        "format": "uuid"
      },
      "kind": {
        "type": "string",
        "enum": [
          "group"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 500
      },
      "stem": {
        "$ref": "#/components/schemas/TextBlock"
      },
      "children": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/LeafQuestion"
        },
        "minItems": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/SourceEvidence"
        }
      }
    },
    "required": [
      "id",
      "nodeId",
      "kind",
      "title",
      "stem",
      "children",
      "evidence"
    ]
  }
}

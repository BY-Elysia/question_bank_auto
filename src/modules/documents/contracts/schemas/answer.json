{
  "name": "Answer",
  "typeFile": "src/modules/documents/domain/answer.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "origin": {
        "type": "string",
        "enum": [
          "source",
          "generated",
          "human",
          "none"
        ]
      },
      "content": {
        "$ref": "#/components/schemas/TextBlock"
      },
      "explanation": {
        "type": "string",
        "maxLength": 200000
      },
      "generationInvocationId": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "origin",
      "content"
    ]
  }
}

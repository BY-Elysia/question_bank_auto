{
  "path": "/api/v1/assets/{assetId}/content",
  "method": "get",
  "operation": {
    "operationId": "downloadAsset",
    "tags": [
      "Assets"
    ],
    "summary": "下载获授权的资产内容",
    "description": "权限校验后流式下载；Content-Disposition 使用安全文件名。仅返回字节，不返回宿主机路径。",
    "x-audience": "public",
    "security": [
      {
        "UserBearer": []
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "assetId",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "请求成功",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "请求追踪 ID"
          },
          "Content-Disposition": {
            "schema": {
              "type": "string"
            },
            "description": "attachment; filename*=UTF-8 编码安全文件名"
          }
        },
        "content": {
          "application/octet-stream": {
            "schema": {
              "type": "string",
              "format": "binary"
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/E400"
      },
      "401": {
        "$ref": "#/components/responses/E401"
      },
      "403": {
        "$ref": "#/components/responses/E403"
      },
      "404": {
        "$ref": "#/components/responses/E404"
      },
      "409": {
        "$ref": "#/components/responses/E409"
      },
      "422": {
        "$ref": "#/components/responses/E422"
      },
      "429": {
        "$ref": "#/components/responses/E429"
      },
      "501": {
        "$ref": "#/components/responses/NotImplemented"
      },
      "503": {
        "$ref": "#/components/responses/E503"
      },
      "default": {
        "$ref": "#/components/responses/Unexpected"
      }
    }
  }
}

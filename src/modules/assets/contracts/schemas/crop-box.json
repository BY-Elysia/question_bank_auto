{
  "name": "CropBox",
  "typeFile": "src/modules/assets/domain/crop-box.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "x": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "y": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "width": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      },
      "height": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      }
    },
    "required": [
      "x",
      "y",
      "width",
      "height"
    ],
    "description": "归一化坐标，左上为原点；x + width <= 1 且 y + height <= 1，由业务校验器检查。"
  }
}

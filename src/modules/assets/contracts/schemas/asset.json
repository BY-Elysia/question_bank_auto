{
  "name": "Asset",
  "typeFile": "src/modules/assets/domain/asset.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "projectId": {
        "type": "string",
        "format": "uuid"
      },
      "kind": {
        "type": "string",
        "enum": [
          "source",
          "page",
          "crop",
          "attachment",
          "export",
          "job_artifact"
        ]
      },
      "originalName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "mediaType": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sourceAssetId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "pageNumber": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "width": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "height": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "projectId",
      "kind",
      "originalName",
      "mediaType",
      "sizeBytes",
      "sha256",
      "sourceAssetId",
      "pageNumber",
      "width",
      "height",
      "createdAt"
    ]
  }
}

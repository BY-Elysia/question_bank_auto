{
  "name": "Publication",
  "typeFile": "src/modules/library/domain/publication.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "projectId": {
        "type": "string",
        "format": "uuid"
      },
      "documentId": {
        "type": "string",
        "format": "uuid"
      },
      "documentRevision": {
        "type": "integer",
        "minimum": 1
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "textbook",
          "exam"
        ]
      },
      "questionCount": {
        "type": "integer",
        "minimum": 0
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "type": "string",
        "enum": [
          "published",
          "withdrawn"
        ]
      }
    },
    "required": [
      "id",
      "projectId",
      "documentId",
      "documentRevision",
      "title",
      "kind",
      "questionCount",
      "createdAt",
      "status"
    ],
    "description": "发布是不可变快照；重复发布同一文档版本返回同一资源，文档后续编辑不修改此快照。"
  }
}

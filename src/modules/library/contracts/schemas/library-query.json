          "format": "uuid"
        }
      },
      "nodeIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "kind": {
        "type": "string",
        "enum": [
          "choice",
          "free_response",
          "group"
        ]
      },
      "cursor": {
        "type": "string",
        "maxLength": 2048
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": []
  }
}

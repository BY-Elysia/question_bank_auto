{
  "name": "ModelProfileCreate",
  "typeFile": "src/modules/model-config/application/dto/model-profile-create.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "role": {
        "$ref": "#/components/schemas/ModelRole"
      },
      "providerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "modelId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "credentialId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "parameters": {
        "$ref": "#/components/schemas/ModelParameters"
      }
    },
    "required": [
      "name",
      "role",
      "providerId",
      "modelId",
      "credentialId",
      "parameters"
    ],
    "description": "credentialId=null 使用用户获授权的平台凭证；模型能力必须匹配 role 和 Skill。"
  }
}

{
  "name": "ModelProfile",
  "typeFile": "src/modules/model-config/domain/model-profile.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "role": {
        "$ref": "#/components/schemas/ModelRole"
      },
      "providerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "modelId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "credentialId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "parameters": {
        "$ref": "#/components/schemas/ModelParameters"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "revision",
      "name",
      "role",
      "providerId",
      "modelId",
      "credentialId",
      "parameters",
      "createdAt",
      "updatedAt"
    ]
  }
}

{
  "name": "Usage",
  "typeFile": "src/modules/model-config/domain/usage.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "inputTokens": {
        "type": "integer",
        "minimum": 0
      },
      "outputTokens": {
        "type": "integer",
        "minimum": 0
      },
      "cachedInputTokens": {
        "type": "integer",
        "minimum": 0
      },
      "modelCalls": {
        "type": "integer",
        "minimum": 0
      },
      "estimatedCost": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "currency": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "CNY",
              "USD"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "inputTokens",
      "outputTokens",
      "cachedInputTokens",
      "modelCalls",
      "estimatedCost",
      "currency"
    ]
  }
}

{
  "name": "Credential",
  "typeFile": "src/modules/model-config/domain/credential.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "providerId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "revoked"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "providerId",
      "name",
      "revision",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "description": "响应不包含 secret、明文 API Key 或可还原的密钥片段。"
  }
}

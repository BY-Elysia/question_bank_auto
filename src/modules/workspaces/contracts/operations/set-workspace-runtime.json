{
  "path": "/api/v1/me/workspace/runtime",
  "method": "put",
  "operation": {
    "operationId": "setWorkspaceRuntime",
    "tags": [
      "Workspace"
    ],
    "summary": "设置容器运行目标状态",
    "description": "异步调谐，每个用户最多一个活动工作区容器；running 时创建或启动，stopped 时有运行任务则 409，先取消并等待任务终态。generation 用作 If-Match。",
    "x-audience": "public",
    "security": [
      {
        "UserBearer": []
      }
    ],
    "parameters": [
      {
        "$ref": "#/components/parameters/IdempotencyKey"
      },
      {
        "$ref": "#/components/parameters/IfMatch"
      }
    ],
    "responses": {
      "202": {
        "description": "已接受；通过资源查询跟踪进度",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "请求追踪 ID"
          },
          "ETag": {
            "schema": {
              "type": "string",
              "pattern": "^\"[1-9][0-9]*\"$"
            },
            "description": "当前资源 revision；runtime 使用 generation。"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WorkspaceRuntime"
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/E400"
      },
      "401": {
        "$ref": "#/components/responses/E401"
      },
      "403": {
        "$ref": "#/components/responses/E403"
      },
      "404": {
        "$ref": "#/components/responses/E404"
      },
      "409": {
        "$ref": "#/components/responses/E409"
      },
      "412": {
        "$ref": "#/components/responses/E412"
      },
      "422": {
        "$ref": "#/components/responses/E422"
      },
      "428": {
        "$ref": "#/components/responses/E428"
      },
      "429": {
        "$ref": "#/components/responses/E429"
      },
      "501": {
        "$ref": "#/components/responses/NotImplemented"
      },
      "503": {
        "$ref": "#/components/responses/E503"
      },
      "default": {
        "$ref": "#/components/responses/Unexpected"
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/RuntimeRequest"
          }
        }
      }
    }
  }
}

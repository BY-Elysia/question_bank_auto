{
  "name": "Checkpoint",
  "typeFile": "src/modules/job-execution/domain/checkpoint.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "sequence": {
        "type": "integer",
        "minimum": 0
      },
      "nextPageIndex": {
        "type": "integer",
        "minimum": 0
      },
      "pendingRanges": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/QuestionRange"
        }
      },
      "currentNodeId": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "candidateArtifactIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "completedStepIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "required": [
      "sequence",
      "nextPageIndex",
      "pendingRanges",
      "currentNodeId",
      "candidateArtifactIds",
      "completedStepIds"
    ],
    "description": "检查点和对应产物在控制服务事务中提交；恢复以此为准，本地文件仅为产物。 nextPageIndex 指 request.pageAssetIds 的零基下标；checkpoint 与 step 产物在同一次 commit 中前进，重放同提交不得推进两次。"
  }
}

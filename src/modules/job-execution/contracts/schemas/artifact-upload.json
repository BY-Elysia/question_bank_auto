{
  "name": "ArtifactUpload",
  "typeFile": "src/modules/job-execution/application/dto/artifact-upload.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "leaseId": {
        "type": "string",
        "format": "uuid"
      },
      "fencingToken": {
        "type": "integer",
        "minimum": 1
      },
      "stepId": {
        "type": "string",
        "format": "uuid"
      },
      "kind": {
        "type": "string",
        "enum": [
          "page",
          "crop",
          "candidate",
          "model_response",
          "log",
          "export"
        ]
      },
      "file": {
        "type": "string",
        "format": "binary"
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "required": [
      "leaseId",
      "fencingToken",
      "stepId",
      "kind",
      "file",
      "sha256"
    ]
  }
}

{
  "name": "WorkerContext",
  "typeFile": "src/modules/job-execution/domain/worker-context.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "document": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/DocumentRevision"
          },
          {
            "type": "null"
          }
        ]
      },
      "assets": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/WorkerAsset"
        }
      },
      "checkpoint": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Checkpoint"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "document",
      "assets",
      "checkpoint"
    ],
    "description": "document 为冻结的 baseRevision 快照；assets 仅包含当前任务获授权的输入。用于 Worker 本地文件定位。"
  }
}

{
  "name": "JobArtifact",
  "typeFile": "src/modules/job-execution/domain/job-artifact.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "jobId": {
        "type": "string",
        "format": "uuid"
      },
      "stepId": {
        "type": "string",
        "format": "uuid"
      },
      "kind": {
        "type": "string",
        "enum": [
          "page",
          "crop",
          "candidate",
          "model_response",
          "log",
          "export"
        ]
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "jobId",
      "stepId",
      "kind",
      "sha256",
      "sizeBytes",
      "createdAt"
    ],
    "description": "id 同时预留为正式 Asset ID。产物字节先写入不可变暂存，complete 只登记同 ID 的资产引用；未提交的孤立字节稍后回收。"
  }
}

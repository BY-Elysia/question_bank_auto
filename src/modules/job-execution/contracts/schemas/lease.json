{
  "name": "Lease",
  "typeFile": "src/modules/job-execution/domain/lease.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "leaseId": {
        "type": "string",
        "format": "uuid"
      },
      "fencingToken": {
        "type": "integer",
        "minimum": 1
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      },
      "heartbeatIntervalSeconds": {
        "type": "integer",
        "minimum": 1
      },
      "job": {
        "$ref": "#/components/schemas/Job"
      },
      "checkpoint": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Checkpoint"
          },
          {
            "type": "null"
          }
        ]
      },
      "context": {
        "$ref": "#/components/schemas/WorkerContext"
      }
    },
    "required": [
      "leaseId",
      "fencingToken",
      "expiresAt",
      "heartbeatIntervalSeconds",
      "job",
      "checkpoint",
      "context"
    ],
    "description": "仅能领取 token 所绑定 workspace 的 queued 任务；每次重新领取 fencingToken 递增。"
  }
}

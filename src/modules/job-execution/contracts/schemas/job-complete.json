{
  "name": "JobComplete",
  "typeFile": "src/modules/job-execution/application/dto/job-complete.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "lease": {
        "$ref": "#/components/schemas/LeaseContext"
      },
      "state": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed",
          "cancelled",
          "needs_input"
        ]
      },
      "proposals": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ProposalDraft"
        }
      },
      "artifactIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "importedContent": {
        "$ref": "#/components/schemas/DocumentContent"
      },
      "questionVersionIds": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "error": {
        "$ref": "#/components/schemas/Problem"
      }
    },
    "required": [
      "lease",
      "state",
      "proposals",
      "artifactIds",
      "questionVersionIds"
    ],
    "description": "失败要求 error；成功按 workflow 类型限制结果。仅 document-import 可提供 importedContent 并创建新文档。控制服务校验、登记资产、创建 proposal/文档和终态，在一个业务事务中完成；模型结果不直接覆盖现有文档。",
    "allOf": [
      {
        "if": {
          "properties": {
            "state": {
              "const": "failed"
            }
          }
        },
        "then": {
          "required": [
            "error"
          ],
          "properties": {
            "error": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    ]
  }
}

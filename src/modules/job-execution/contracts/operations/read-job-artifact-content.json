{
  "path": "/internal/v1/jobs/{jobId}/artifacts/read",
  "method": "post",
  "operation": {
    "operationId": "readJobArtifactContent",
    "tags": [
      "Worker"
    ],
    "summary": "读取当前任务的暂存产物",
    "description": "读取模型原始响应或步骤产物，校验租约和 artifactId 归属。过期 Worker 不再获得读取权限。 内部端点不得暴露到公网入口；工作区令牌还需具备该操作 scope。",
    "x-audience": "workspace",
    "security": [
      {
        "WorkspaceBearer": []
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "jobId",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "$ref": "#/components/parameters/IdempotencyKey"
      }
    ],
    "responses": {

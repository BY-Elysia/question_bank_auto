{
  "name": "JobProgress",
  "typeFile": "src/modules/jobs/domain/job-progress.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "completedUnits": {
        "type": "integer",
        "minimum": 0
      },
      "totalUnits": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      },
      "phase": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "completedUnits",
      "totalUnits",
      "phase"
    ]
  }
}

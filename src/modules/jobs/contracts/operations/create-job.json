{
  "path": "/api/v1/projects/{projectId}/jobs",
  "method": "post",
  "operation": {
    "operationId": "createJob",
    "tags": [
      "Jobs"
    ],
    "summary": "提交后台工作流",
    "description": "验证所有输入资产/文档归属和版本，冻结执行计划与额度，事务写 job+outbox；异步投递队列。容器未就绪时保持 queued 并请求启动。AI 输出默认生成 proposal，用户明确 apply 后才更新现有文档。",
    "x-audience": "public",
    "security": [
      {
        "UserBearer": []
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "projectId",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      {
        "$ref": "#/components/parameters/IdempotencyKey"
      }
    ],
    "responses": {
      "202": {
        "description": "已接受；通过资源查询跟踪进度",
        "headers": {
          "X-Request-Id": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "请求追踪 ID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      },
      "400": {
        "$ref": "#/components/responses/E400"
      },
      "401": {
        "$ref": "#/components/responses/E401"
      },
      "403": {
        "$ref": "#/components/responses/E403"
      },
      "404": {
        "$ref": "#/components/responses/E404"
      },
      "409": {
        "$ref": "#/components/responses/E409"
      },
      "422": {
        "$ref": "#/components/responses/E422"
      },
      "429": {
        "$ref": "#/components/responses/E429"
      },
      "501": {
        "$ref": "#/components/responses/NotImplemented"
      },
      "503": {
        "$ref": "#/components/responses/E503"
      },
      "default": {
        "$ref": "#/components/responses/Unexpected"
      }
    },
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/components/schemas/JobCreate"
          },
          "examples": {
            "example1": {
              "summary": "PDF 转图任务",
              "value": {
                "request": {
                  "kind": "pdf-render",
                  "sourceAssetIds": [
                    "00000000-0000-4000-8000-000000000001"
                  ],
                  "dpi": 180,
                  "format": "png"
                }
              }
            },
            "example2": {
              "summary": "教材提取任务",
              "value": {
                "request": {
                  "kind": "textbook-extraction",
                  "documentId": "00000000-0000-4000-8000-000000000005",
                  "baseRevision": 1,
                  "pageAssetIds": [
                    "00000000-0000-4000-8000-000000000002"
                  ],
                  "initialNodeId": "00000000-0000-4000-8000-000000000003",
                  "strategy": "standard",
                  "verification": "flagged",
                  "maxPendingPages": 8
                },
                "aiConfigurationRevision": 1
              }
            },
            "example3": {
              "summary": "公式修复任务",
              "value": {
                "request": {
                  "kind": "question-edit",
                  "documentId": "00000000-0000-4000-8000-000000000005",
                  "baseRevision": 1,
                  "questionId": "00000000-0000-4000-8000-000000000004",
                  "targetPointer": "/questions/0/prompt/text",
                  "input": {
                    "kind": "math-format-repair",
                    "text": "求函数 f(x)=x² 的导数。",
                    "sourceAssetIds": [
                      "00000000-0000-4000-8000-000000000002"
                    ]
                  }
                },
                "aiConfigurationRevision": 1
              }
            },
            "example4": {
              "summary": "试卷组装任务",
              "value": {
                "request": {
                  "kind": "exam-compose",
                  "documentId": "00000000-0000-4000-8000-000000000006",
                  "baseRevision": 2,
                  "sections": [
                    {
                      "title": "一、计算题",
                      "questionVersionIds": [
                        "00000000-0000-4000-8000-000000000007"
                      ],
                      "scorePerQuestion": 10
                    }
                  ]
                }
              }
            },
            "example5": {
              "summary": "导出带图片题库",
              "value": {
                "request": {
                  "kind": "document-export",
                  "documentId": "00000000-0000-4000-8000-000000000005",
                  "revision": 2,
                  "format": "question-bank-bundle",
                  "includeMedia": true
                }
              }
            }
          }
        }
      }
    }
  }
}

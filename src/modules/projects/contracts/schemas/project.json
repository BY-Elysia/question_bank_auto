{
  "name": "Project",
  "typeFile": "src/modules/projects/domain/project.ts",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "workspaceId": {
        "type": "string",
        "format": "uuid"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "textbook",
          "exam"
        ]
      },
      "description": {
        "type": "string",
        "maxLength": 4000
      },
      "archived": {
        "type": "boolean"
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "workspaceId",
      "name",
      "kind",
      "description",
      "archived",
      "revision",
      "createdAt",
      "updatedAt"
    ]
  }
}

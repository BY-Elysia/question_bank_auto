PORT=5002
HOST=127.0.0.1
WORKSPACE_ROOT=./workspace
# Both protocols use a base URL ending before /responses or /chat/completions.
MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MODEL_PROTOCOL=responses
MODEL_API_KEY=
MODEL_NAME=
# Optional separate model names; defaults to MODEL_NAME.
VISION_MODEL=
REASONING_MODEL=
MODEL_TIMEOUT_MS=180000
MAX_PDF_PAGES=2000
MAX_PENDING_PAGES=12
MAX_UPLOAD_SIZE=100mb
# Optional binary overrides:
# PDFINFO_BIN=/usr/local/bin/pdfinfo
# PDFTOPPM_BIN=/usr/local/bin/pdftoppm

# Opt in to local model traces (raw outputs and task inputs; no API key or image bytes).
# Records live under WORKSPACE_ROOT/books/<bookId>/runs/<jobId> with mode 0600.
MODEL_TRACE=0

# Optional single-administrator login. Public deployments must enable this.
ACCESS_REQUIRED=0
ACCESS_USERNAME=admin
# salt:hash produced by hashPassword; never store the plaintext password here.
ACCESS_PASSWORD_HASH=
ACCESS_SECURE_COOKIE=1
